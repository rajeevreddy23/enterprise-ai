# Enterprise AI Assistant - Backend Environment Configuration

# Project & Security
PROJECT_NAME="Enterprise AI Knowledge Assistant"
VERSION="1.0.0"
SECRET_KEY="replace-this-with-a-random-high-entropy-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default: Embedded SQLite async for out-of-the-box local operation
DATABASE_URL="sqlite+aiosqlite:///./data/enterprise_ai.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_ai"

# Qdrant Vector Store
# Leave QDRANT_URL empty to use local embedded file storage in ./data/qdrant_storage
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="enterprise_knowledge"
QDRANT_STORAGE_PATH="./data/qdrant_storage"

# Google Gemini API
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"
EMBEDDING_DIMENSION=768

# RAG & Chunking Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=6
HYBRID_ALPHA=0.6

# Storage & Uploads
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_SIZE_MB=50

# Optional Supabase Integration
SUPABASE_URL=""
SUPABASE_KEY=""
